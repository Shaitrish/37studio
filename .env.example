# Claude Code auth for the editor agent: set ONE of these.
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` and bills your Claude subscription.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Gemini (Google AI Studio) for image + video generation. Optional.
GEMINI_API_KEY=

# ElevenLabs for voiceover, sound effects and music. Optional.
ELEVENLABS_API_KEY=

# Optional: password-protect the whole app (HTTP basic auth, any username).
STUDIO37_PASSWORD=

# safe   = agent may only use an allowlist of tools (ffmpeg, npx hyperframes, file edits, ...)
# bypass = full autonomy. Only use inside the Docker container, which is the sandbox.
STUDIO37_AGENT_PERMISSIONS=safe

# Social publishing (see README → Social publishing). Each block is optional.
# Where the platforms send the browser back after sign-in; must match the registered redirect URIs.
STUDIO37_PUBLIC_URL=http://localhost:8080
# The relay for the shared Meta app's sign-in and for WhatsApp messages (README → Run your own relay).
# STUDIO37_AUTH_URL=https://studio.shaitrish.com
# Facebook Pages + Instagram: your own Meta app. META_CONFIG_ID is the Facebook Login for Business configuration.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# YouTube: a Google Cloud OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: Login Kit + Content Posting API app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# LinkedIn: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn". LINKEDIN_PAGES=1 once LinkedIn grants
# the Community Management API, to post to the Pages you administer too.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_PAGES=1
# X: OAuth 2.0 (confidential client) on a plan that allows posting with media.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Pinterest: an app at developers.pinterest.com. Trial-access apps write only to the sandbox:
# PINTEREST_API=https://api-sandbox.pinterest.com
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Bluesky and Mastodon need no app: connect them with an app password or access token on the company's Social tab.
# Each of these can also be entered in Settings → Keys instead.
